# Required: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Recommended: 32-character AES secret key for encrypting cookie jars
LG_SECRET="your-32-character-secret-key-here"

# Optional: Require a key to access the gateway (prevents open proxy use)
LG_GATE_KEY="gateway"

# Optional: Browserless token for Snapshot Mode (complex SPAs)
BROWSERLESS_TOKEN=""
